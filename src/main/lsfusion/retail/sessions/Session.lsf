MODULE Session;

REQUIRE MetaNumerator, Time, DateUtils, Doc,
        RetailSettings, Pos;

NAMESPACE Retail;

CLASS Session '{Session}';

openingDateTime 'Opened' = DATA DATETIME (Session) NONULL;
openingDateTime(Session s) <- currentDateTime() WHEN SET(s IS Session);
@defineDateTimeAggregation(Session, opening, '(opening)');

closingDateTime 'Closed' = DATA DATETIME (Session);
CONSTRAINT closingDateTime(Session s) < openingDateTime(s)
    MESSAGE 'The session cannot be closed earlier than it was open';

opened 'Opened' (Session s) = openingDateTime(s) AND NOT closingDateTime(s);

nameStatus 'Status' (Session s) = CASE WHEN opened(s) THEN 'Opened' WHEN closingDateTime(s) THEN 'Closed';

@defineNumber(session, 'Sessions', 'SM');

numberDate 'Description' (Session s) = number(s) + ' (' + openingDateTime(s) + ')' IN id;

pos 'POS' = DATA Pos (Session) NONULL;
namePos 'POS' (Session s) = name(pos(s));

company 'Company' (Session s) = company(pos(s));
nameCompany 'Company' (Session s) = name(company(s));

// opened
openedSession (Pos p) = GROUP AGGR Session s WHERE opened(s) BY pos(s);

// actions
breakSession = DATA LOCAL BOOLEAN ();

beforeOpen ABSTRACT LIST (Session);
afterOpen ABSTRACT LIST (Session);
openSession 'Open session' (Pos p) {
    CANCEL;

    NEWSESSION {
        IF NOT openedSession(p) THEN
            NEW s = Session {
                pos(s) <- p;
                beforeOpen(s);
                IF NOT breakSession() THEN {
                    APPLY;
                    IF NOT canceled() THEN
                        afterOpen(s);
                }
            }
        ELSE
            MESSAGE 'There is already an open session';
    }
}

beforeClose ABSTRACT LIST (Session);
afterClose ABSTRACT LIST (Session);
close 'Close session' (Session s) {
    CANCEL;

    NEWSESSION {
        closingDateTime(s) <- currentDateTime();
        beforeClose(s);
        IF NOT breakSession() THEN {
            APPLY;
            IF NOT canceled() THEN
                afterClose(s);
        }
    }
} CONFIRM;

FORM session '{Session}'
    OBJECTS s = Session PANEL
    PROPERTIES(s) namePos, number, 
                  openingDateTime, closingDateTime
    PROPERTIES(s) READONLY nameStatus
    PROPERTIES(s) close SHOWIF opened(s)
    
    EDIT Session OBJECT s
;

@defineFormStatusContainer(session);

DESIGN session {
    caption = badgedDoc('{Session}', number(s), openingDateTime(s));
    primaryActions {
        MOVE PROPERTY(close(s)) { valueClass = 'btn-primary'; }
    }
    status {
        MOVE PROPERTY(nameStatus(s));
    }
    OBJECTS {
        NEW header {
            NEW headerMain {
                horizontal = TRUE;
                alignment = STRETCH;
                NEW headerLeft {
                    MOVE PROPERTY(namePos(s)) { notNull = TRUE; }
                    MOVE PROPERTY(number(s));
                }
                NEW headerRight {
                    MOVE PROPERTY(openingDateTime(s));
                    MOVE PROPERTY(closingDateTime(s));
                }
            }
        }
        NEW tabbedPane {
            fill = 1;
            tabbed = TRUE;
        }
    }
}

FORM sessions 'Sessions'
    OBJECTS o = Session
    PROPERTIES(o) READONLY number, openingDateTime, closingDateTime, nameStatus, namePos, nameCompany
    PROPERTIES(o) NEWSESSION NEW, EDIT, DELETE
    
    FILTERGROUP status
        FILTER 'Opened' opened(o) 'F8'
        FILTER 'Closed' closingDateTime(o) 'F7'
    
    LIST Session OBJECT o
;

@defineDocObjectsForm(sessions, o, 'Sessions');

@defineDateFilterForm(sessions, o, opening);

@defineDocFilter(session, Pos, pos, o, 'POS');
@defineDocFilter(session, Company, company, o, 'Company');

NAVIGATOR {
    operations {
        NEW sessions;
    }
}
