MODULE DebtPartner;

REQUIRE Debt, Partner;

NAMESPACE Invoicing;

currency = DATA Currency (Partner);
nameCurrency 'Currency' (Partner p) = name(currency(p));
currency (Debt d) += currency(partner(d));

debt 'Debt' (Debt d) = PARTITION SUM signedAmount(d) IF active(d) ORDER dateTime(d), d BY partner(d); 

debt 'Debt' (Partner p) = GROUP SUM signedAmount(Debt d) IF active(d) AND partner(d) = p;

pastDueDebt 'Overdue debt' (Partner p) = GROUP SUM signedLeft(Debt d) IF active(d) AND partner(d) = p AND dueDateTime(d) < currentDateTime();

// as of a date, within a company
debt 'Debt' (Company c, Partner p, DATE dt) = GROUP SUM signedLeft(Debt d, dt) IF active(d) AND company(d) = c AND partner(d) = p;
notDueDebt 'Not due' (Company c, Partner p, DATE dt) = GROUP SUM signedLeft(Debt d, dt) IF active(d) AND company(d) = c AND partner(d) = p AND NOT dueDate(d) < dt;

// the signed sum of the documents up to a date (the debt of the partner card within a company as of that date,
// unlike debt(c, p, dt) above, which is what is left after the matched payments) and the turnovers of a period
balance 'Balance' (Company c, Partner p, DATE dt) = GROUP SUM signedAmount(Debt d) IF active(d) AND company(d) = c AND partner(d) = p AND date(d) <= dt;

openingBalance 'Opening balance' (Company c, Partner p, INTERVAL[DATE] i) = balance(c, p, subtract(from(i), 1));
debit 'Debit' (Company c, Partner p, INTERVAL[DATE] i) = GROUP SUM debit(Debt d) IF active(d) AND company(d) = c AND partner(d) = p AND date(d) >= from(i) AND date(d) <= to(i);
credit 'Credit' (Company c, Partner p, INTERVAL[DATE] i) = GROUP SUM credit(Debt d) IF active(d) AND company(d) = c AND partner(d) = p AND date(d) >= from(i) AND date(d) <= to(i);
closingBalance 'Closing balance' (Company c, Partner p, INTERVAL[DATE] i) = balance(c, p, to(i));
countDebt 'Documents' (Company c, Partner p, INTERVAL[DATE] i) = GROUP SUM 1 IF active(Debt d) AND company(d) = c AND partner(d) = p AND date(d) >= from(i) AND date(d) <= to(i);

// the currency of the partner's debts: the default one, or the partner's own when the conversion is switched off
currency (Company c, Partner p) = GROUP MAX currency(Debt d) IF active(d) AND company(d) = c AND partner(d) = p;

// totals over the active partners: what partners owe the company, what the company owes partners, and the overdue part
debt 'Debt' () = GROUP SUM debt(Partner p) IF debt(p) > 0 AND active(p);
payable 'Payables' () = GROUP SUM -debt(Partner p) IF debt(p) < 0 AND active(p);
pastDueDebt 'Overdue debt' () = GROUP SUM pastDueDebt(Partner p) IF pastDueDebt(p) > 0 AND active(p);

FORM partnerDebts 'Partner debts'
    OBJECTS p = Partner PANEL
    PROPERTIES(p) READONLY name

    OBJECTS d = Debt
    PROPERTIES(d) READONLY class, type, number, dateTime, dueDateTime, overdueDays, nameCompany, 
                           sourceAmount, nameSourceCurrency, rate1, amount, left, debt
    PROPERTIES(d) NEWSESSION EDIT
    ORDERS dateTime(d)
    
    FILTERGROUP pastDue
        FILTER 'Overdue' dueDateTime(d) < currentDateTime() AND signedLeft(d)
    FILTERS active(d),
            partner(d) = p
;

EXTEND FORM partner
    PROPERTIES(p) nameCurrency
    PROPERTIES(p) ON CHANGE { SHOW partnerDebts OBJECTS p = p WINDOW; } debt, pastDueDebt
;
DESIGN partner {
    headerRight {
        MOVE PROPERTY(nameCurrency(p));
        MOVE PROPERTY(debt(p));
        MOVE PROPERTY(pastDueDebt(p));
    }
}

EXTEND FORM partners
    PROPERTIES(p) READONLY nameCurrency, debt, pastDueDebt
;