MODULE ShipmentPrintInitial;

REQUIRE ShipmentPrint, ShipmentInitial;

NAMESPACE Inventory;

loadDefaultData () + {
    NEW tm = ShipmentTemplate {
        name(tm) <- r'Delivery note';
        template(tm) <- r'DeliveryNote.jrxml';
        in(tm, ShipmentType t) <- TRUE WHERE id(t) = 'shipment';
    }
}
